{
  "name": "nirengi-ui",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "kill -9 $(lsof -t -i :4200) 2>/dev/null || true && ng serve",
    "build": "ng build",
    "build:ui-kit": "ng build nirengi-ui-kit",
    "postbuild:ui-kit": "npm run build:styles",
    "build:ui-kit:prod": "ng build nirengi-ui-kit --configuration=production",
    "postbuild:ui-kit:prod": "npm run build:styles",
    "build:styles": "node scripts/build-styles.mjs",
    "publish:ui-kit": "npm run build:ui-kit:prod && npm publish ./dist/nirengi-ui-kit",
    "watch": "ng build --watch --configuration development",
    "test:app": "ng test nirengi-ui --browsers=ChromeHeadless --watch=false --code-coverage",
    "test:ui-kit": "ng test nirengi-ui-kit --browsers=ChromeHeadless --watch=false --code-coverage",
    "test:coverage:merge": "COVERAGE_LINES=96 COVERAGE_FUNCTIONS=96 COVERAGE_BRANCHES=90 COVERAGE_STATEMENTS=96 node scripts/merge-coverage.mjs",
    "test": "npm run test:app && npm run test:ui-kit && npm run test:coverage:merge",
    "lint": "eslint \"{src,projects}/**/*.{ts,html}\"",
    "format": "prettier --write \"{src,projects}/**/*.{ts,html,scss,css,json,md}\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "date-fns": "^4.1.0",
    "lucide-angular": "^0.563.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.5",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.20.0"
  }
}
