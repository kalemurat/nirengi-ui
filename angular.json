{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nirengi-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "50kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "nirengi-ui:build:production"
            },
            "development": {
              "buildTarget": "nirengi-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "nirengi-ui:build:development",
            "tsConfig": "tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "coverageReporters": ["html", "text-summary", "json-summary"],
            "coverageExclude": [
              "**/*.html",
              "**/*.spec.ts",
              "**/*.interface.ts",
              "**/*.interfaces.ts",
              "**/*.enum.ts",
              "**/*.type.ts",
              "**/*.types.ts",
              "**/index.ts",
              "src/main.ts"
            ]
          }
        }
      }
    },
    "nirengi-ui-kit": {
      "projectType": "library",
      "root": "projects/nirengi-ui-kit",
      "sourceRoot": "projects/nirengi-ui-kit/src",
      "prefix": "nui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/nirengi-ui-kit/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nirengi-ui-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nirengi-ui-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "nirengi-ui:build:development",
            "tsConfig": "projects/nirengi-ui-kit/tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "coverageReporters": ["html", "text-summary", "json-summary"],
            "coverageThresholds": {
              "statements": 93,
              "branches": 85,
              "functions": 98,
              "lines": 92
            },
            "coverageExclude": [
              "**/*.html",
              "**/*.spec.ts",
              "**/*.interface.ts",
              "**/*.interfaces.ts",
              "**/*.enum.ts",
              "**/*.type.ts",
              "**/*.types.ts",
              "**/index.ts",
              "**/public-api.ts",
              "**/*.token.ts",
              "**/*constants.ts",
              "**/design-tokens/**"
            ]
          }
        }
      }
    }
  }
}
