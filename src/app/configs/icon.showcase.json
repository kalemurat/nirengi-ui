{
  "id": "icon",
  "name": "Icon",
  "description": "RemixIcon wrapper with type safety and customization options",
  "category": "Media",
  "selector": "nirengi-icon",
  "properties": [
    {
      "name": "name",
      "type": "string",
      "label": "Icon Name",
      "defaultValue": "home-line",
      "description": "RemixIcon name in kebab-case, without the ri- prefix",
      "options": [
        { "label": "home-line", "value": "home-line" },
        { "label": "user-line", "value": "user-line" },
        { "label": "settings-line", "value": "settings-line" },
        { "label": "delete-bin-line", "value": "delete-bin-line" },
        { "label": "check-line", "value": "check-line" },
        { "label": "error-warning-line", "value": "error-warning-line" },
        { "label": "information-line", "value": "information-line" },
        { "label": "heart-fill", "value": "heart-fill" }
      ]
    },
    {
      "name": "size",
      "type": "number",
      "label": "Size",
      "defaultValue": 24,
      "description": "Size of the icon in pixels"
    },
    {
      "name": "color",
      "type": "string",
      "label": "Color",
      "defaultValue": "currentColor",
      "description": "Fill color of the icon (CSS color string)"
    }
  ],
  "examples": [
    {
      "title": "Default Icon",
      "description": "Standard size home icon",
      "propertyValues": {
        "name": "home-line"
      }
    },
    {
      "title": "Large Icon",
      "description": "Large blue user icon",
      "propertyValues": {
        "name": "user-line",
        "size": 48,
        "color": "#3b82f6"
      }
    },
    {
      "title": "Filled Variant",
      "description": "RemixIcon ships a line and a fill variant for most glyphs",
      "propertyValues": {
        "name": "heart-fill",
        "color": "#ef4444",
        "size": 32
      }
    }
  ]
}
